   "source": [
    "**Cutoffs (°C):** Cold = below 15 Warm = 15 to 25 Hot = above 25."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ac9d5707-aa33-480f-b43f-3a039d96c425",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "10°C: Cold\n",
      "16°C: Warm\n",
      "23°C: Warm\n",
      "28°C: Hot\n",
      "14°C: Cold\n",
      "22°C: Warm\n",
      "30°C: Hot\n"
     ]
    }
   ],
   "source": [
    "temperatures = [10, 16, 23, 28, 14, 22, 30]\n",
    "\n",
    "for t in temperatures:\n",
    "    if t < 15:\n",
    "        label = \"Cold\"\n",
    "    elif t <= 25:\n",
    "        label = \"Warm\"\n",
    "    else:\n",
    "        label = \"Hot\"\n",
    "    print(f\"{t}°C: {label}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b730cd77-43d2-4628-b88d-e7c2380e4879",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Boundary check - 15°C: Warm\n",
      "Boundary check - 25°C: Warm\n"
     ]
    }
   ],
   "source": [
    "for t in [15, 25]:\n",
    "    if t < 15:\n",
    "        label = \"Cold\"\n",
    "    elif t <= 25:\n",
    "        label = \"Warm\"\n",
    "    else:\n",
    "        label = \"Hot\"\n",
    "    print(f\"Boundary check - {t}°C: {label}\")"
   ]
